#!/bin/sh

target="${1:-${TMUX_PANE:-}}"

if [ -z "$target" ] || ! command -v tmux >/dev/null 2>&1; then
	exit 0
fi

# No marker on this window? Nothing to clear. This keeps the high-frequency
# pane-focus-in / select-window hooks from spawning a sleep on every event.
current="$(tmux show-options -wqv -t "$target" @agent_attention 2>/dev/null || printf '')"
if [ -z "$current" ]; then
	exit 0
fi

# Respect the global opt-out. When clear-on-view is disabled the marker should
# persist until it is cleared explicitly, so neither the focus/select hooks nor
# the CLI's post-set auto-clear on the active window should schedule a clear.
clear_on_view="$(tmux show-option -gqv @tmux_attention_clear_on_view 2>/dev/null || printf 'on')"
if [ "$clear_on_view" != "on" ]; then
	exit 0
fi

delay="$(tmux show-option -gqv @tmux_attention_clear_delay 2>/dev/null || printf '8')"

case "$delay" in
	''|*[!0-9]*)
		delay=8
		;;
esac

quote_for_single_quotes() {
	printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

# Capture the marker's timestamp too: comparing only the state string would
# clear a marker that was re-set with the *same* state during the sleep.
updated_at="$(tmux show-options -wqv -t "$target" @agent_attention_updated_at 2>/dev/null || printf '')"

escaped_target="$(quote_for_single_quotes "$target")"
escaped_current="$(quote_for_single_quotes "$current")"
escaped_updated_at="$(quote_for_single_quotes "$updated_at")"
# Clear all four options together, matching the CLI's `clear`, so no stale
# source/reason/updated_at survives an auto-clear.
tmux run-shell -b "sleep $delay; current=\$(tmux show-options -wqv -t '$escaped_target' @agent_attention 2>/dev/null || printf ''); updated=\$(tmux show-options -wqv -t '$escaped_target' @agent_attention_updated_at 2>/dev/null || printf ''); if [ \"\$current\" = '$escaped_current' ] && [ \"\$updated\" = '$escaped_updated_at' ]; then tmux set-window-option -q -t '$escaped_target' @agent_attention '' || true; tmux set-window-option -q -t '$escaped_target' @agent_attention_source '' || true; tmux set-window-option -q -t '$escaped_target' @agent_attention_reason '' || true; tmux set-window-option -q -t '$escaped_target' @agent_attention_updated_at '' || true; fi"

#!/bin/sh

set -eu

usage() {
	cat <<'EOF'
Usage: install-hooks [--status|--print|--uninstall] [claude|codex|all]

Installs tmux-attention hooks for Claude Code and/or Codex.

Environment overrides for tests or custom locations:
  TMUX_ATTENTION_CLI
  TMUX_ATTENTION_CLAUDE_SETTINGS
  TMUX_ATTENTION_CODEX_HOOKS
  CODEX_HOME (default Codex hooks path is $CODEX_HOME/hooks.json, falling back
              to ~/.codex/hooks.json; TMUX_ATTENTION_CODEX_HOOKS wins)
EOF
}

action="install"
target=""

while [ "$#" -gt 0 ]; do
	case "$1" in
		--status)
			action="status"
			shift
			;;
		--print)
			action="print"
			shift
			;;
		--uninstall)
			action="uninstall"
			shift
			;;
		-h|--help|help)
			usage
			exit 0
			;;
		claude|codex|all)
			if [ -n "$target" ]; then
				printf 'install-hooks: unexpected argument: %s\n' "$1" >&2
				usage >&2
				exit 2
			fi
			target="$1"
			shift
			;;
		*)
			printf 'install-hooks: unknown argument: %s\n' "$1" >&2
			usage >&2
			exit 2
			;;
	esac
done

target="${target:-all}"

if ! command -v python3 >/dev/null 2>&1; then
	printf 'install-hooks: python3 is required to edit JSON hook config files\n' >&2
	exit 1
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CLI_PATH="${TMUX_ATTENTION_CLI:-$SCRIPT_DIR/tmux-attention}"
CLAUDE_SETTINGS="${TMUX_ATTENTION_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
CODEX_HOOKS="${TMUX_ATTENTION_CODEX_HOOKS:-${CODEX_HOME:-$HOME/.codex}/hooks.json}"

export TMUX_ATTENTION_INSTALL_ACTION="$action"
export TMUX_ATTENTION_INSTALL_TARGET="$target"
export TMUX_ATTENTION_CLI_PATH="$CLI_PATH"
export TMUX_ATTENTION_CLAUDE_PATH="$CLAUDE_SETTINGS"
export TMUX_ATTENTION_CODEX_PATH="$CODEX_HOOKS"

python3 - <<'PY'
import copy
import json
import os
import shlex
import shutil
from datetime import datetime
from pathlib import Path

ACTION = os.environ["TMUX_ATTENTION_INSTALL_ACTION"]
TARGET = os.environ["TMUX_ATTENTION_INSTALL_TARGET"]
CLI = os.environ["TMUX_ATTENTION_CLI_PATH"]
CLAUDE_PATH = Path(os.environ["TMUX_ATTENTION_CLAUDE_PATH"]).expanduser()
CODEX_PATH = Path(os.environ["TMUX_ATTENTION_CODEX_PATH"]).expanduser()
MARKER = "tmux-attention:"
HOME = os.environ.get("HOME", "")


def cli_token():
    # Emit a $HOME-relative command when the CLI lives under $HOME, so the
    # generated hook config is portable across machines (different usernames or
    # home paths). Agent hook runners execute the command string through a shell
    # — Claude Code via the user's shell, Codex via `$SHELL -lc "<command>"` —
    # so "$HOME" expands at run time. Falls back to the absolute path otherwise.
    if HOME and (CLI == HOME or CLI.startswith(HOME + os.sep)):
        rel = CLI[len(HOME):].lstrip(os.sep)
        return '"$HOME"/' + shlex.quote(rel)
    return shlex.quote(CLI)


def command(state, marker):
    return f"{cli_token()} {state} # {MARKER}{marker}"


CLAUDE_HOOKS = {
    "Notification": [
        {
            "matcher": "permission_prompt|idle_prompt",
            "hooks": [
                {
                    "type": "command",
                    "command": command("input", "claude:notification"),
                }
            ],
        }
    ],
    "StopFailure": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command("blocked", "claude:stop-failure"),
                }
            ],
        }
    ],
    "UserPromptSubmit": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command("turn-start", "claude:turn-start"),
                }
            ],
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command(
                        "turn-done --source claude --reason response_ready",
                        "claude:turn-done",
                    ),
                }
            ],
        }
    ],
}

CODEX_HOOKS = {
    "PreToolUse": [
        {
            "matcher": ".*",
            "hooks": [
                {
                    "type": "command",
                    "command": command("turn-active", "codex:turn-active"),
                }
            ],
        }
    ],
    "PermissionRequest": [
        {
            "matcher": ".*",
            "hooks": [
                {
                    "type": "command",
                    "command": command("input", "codex:permission-request"),
                }
            ],
        }
    ],
    "UserPromptSubmit": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command("turn-start", "codex:turn-start"),
                }
            ],
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command(
                        "turn-done --source codex --reason response_ready",
                        "codex:turn-done",
                    ),
                }
            ],
        }
    ],
}


def targets():
    if TARGET == "all":
        return [("claude", CLAUDE_PATH, CLAUDE_HOOKS), ("codex", CODEX_PATH, CODEX_HOOKS)]
    if TARGET == "claude":
        return [("claude", CLAUDE_PATH, CLAUDE_HOOKS)]
    return [("codex", CODEX_PATH, CODEX_HOOKS)]


def load_json(path):
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as handle:
        text = handle.read().strip()
    if not text:
        return {}
    return json.loads(text)


def prune_backups(path, keep=5):
    backups = sorted(path.parent.glob(path.name + ".bak.*"))
    for old in backups[:-keep]:
        try:
            old.unlink()
        except OSError:
            pass


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        stamp = datetime.now().strftime("%Y%m%d%H%M%S")
        shutil.copy2(path, f"{path}.bak.{stamp}")
        prune_backups(path)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    tmp_path.replace(path)


def remove_managed_hooks(config):
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        config["hooks"] = {}
        return config

    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue

        next_groups = []
        for group in groups:
            if not isinstance(group, dict):
                next_groups.append(group)
                continue

            group_copy = copy.deepcopy(group)
            handlers = group_copy.get("hooks")
            if not isinstance(handlers, list):
                next_groups.append(group_copy)
                continue

            group_copy["hooks"] = [
                handler
                for handler in handlers
                if not (
                    isinstance(handler, dict)
                    and isinstance(handler.get("command"), str)
                    and MARKER in handler["command"]
                )
            ]

            if group_copy["hooks"]:
                next_groups.append(group_copy)

        if next_groups:
            hooks[event] = next_groups
        else:
            del hooks[event]

    return config


def merge_hooks(config, managed_hooks):
    config = remove_managed_hooks(config)
    hooks = config.setdefault("hooks", {})
    for event, groups in managed_hooks.items():
        hooks.setdefault(event, [])
        hooks[event].extend(copy.deepcopy(groups))
    return config


def count_managed_hooks(config):
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        return 0
    return sum(
        1
        for groups in hooks.values()
        if isinstance(groups, list)
        for group in groups
        if isinstance(group, dict)
        for handler in group.get("hooks", [])
        if isinstance(handler, dict)
        and isinstance(handler.get("command"), str)
        and MARKER in handler["command"]
    )


def marker_tail(command):
    index = command.find(MARKER)
    return command[index:] if index != -1 else None


def has_managed_hooks(config, managed_hooks):
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        return False
    # Match on the stable marker comment (e.g. "tmux-attention:claude:notification")
    # rather than the full command, so detection does not depend on the absolute
    # CLI path. This keeps status consistent with marker-based uninstall.
    expected = [
        tail
        for groups in managed_hooks.values()
        for group in groups
        for handler in group["hooks"]
        for tail in [marker_tail(handler["command"])]
        if tail is not None
    ]
    if not expected:
        return False
    commands = [
        handler.get("command")
        for groups in hooks.values()
        if isinstance(groups, list)
        for group in groups
        if isinstance(group, dict)
        for handler in group.get("hooks", [])
        if isinstance(handler, dict)
    ]
    commands = [cmd for cmd in commands if isinstance(cmd, str)]
    return all(any(tail in cmd for cmd in commands) for tail in expected)


def print_snippet(name, managed_hooks):
    print(f"# {name}")
    print(json.dumps({"hooks": managed_hooks}, indent=2))


for name, path, managed_hooks in targets():
    if ACTION == "print":
        print_snippet(name, managed_hooks)
        continue

    config = load_json(path)

    if ACTION == "status":
        state = "installed" if has_managed_hooks(config, managed_hooks) else "not installed"
        print(f"{name}: {state} ({path})")
        continue

    if ACTION == "uninstall":
        # Leave the file alone when there is nothing to remove: never create a
        # config that did not exist, and never reformat/back up one that has no
        # managed entries.
        if not path.exists() or count_managed_hooks(config) == 0:
            print(f"{name}: nothing to uninstall ({path})")
            continue
        next_config = remove_managed_hooks(config)
        write_json(path, next_config)
        print(f"{name}: uninstalled ({path})")
        continue

    next_config = merge_hooks(config, managed_hooks)
    write_json(path, next_config)
    print(f"{name}: installed ({path})")
PY

#!/bin/sh

set -eu

usage() {
	cat <<'EOF'
Usage: setup [claude|codex|all] [--status-line default|catppuccin|none] [--tmux-config PATH] [--no-hooks] [--reload] [--uninstall]

Installs or uninstalls tmux-attention agent hooks and a managed tmux status snippet.

Defaults:
  target: codex
  status line: default
  tmux config: ~/.tmux.conf

Already have a custom theme (e.g. a custom @catppuccin_window_text)? Use
--status-line none and add #{E:@tmux_attention_status} to your own window
format. See the README "Marker Does Not Show" section.

Environment overrides:
  TMUX_ATTENTION_TMUX_CONF
EOF
}

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
target="codex"
status_line="default"
install_hooks="yes"
action="install"
reload_tmux="no"
tmux_config="${TMUX_ATTENTION_TMUX_CONF:-$HOME/.tmux.conf}"

while [ "$#" -gt 0 ]; do
	case "$1" in
		claude|codex|all)
			target="$1"
			shift
			;;
		--status-line)
			if [ "$#" -lt 2 ]; then
				printf 'setup: --status-line requires default, catppuccin, or none\n' >&2
				exit 2
			fi
			status_line="$2"
			shift 2
			;;
		--tmux-config)
			if [ "$#" -lt 2 ]; then
				printf 'setup: --tmux-config requires a path\n' >&2
				exit 2
			fi
			tmux_config="$2"
			shift 2
			;;
		--no-hooks)
			install_hooks="no"
			shift
			;;
		--reload)
			reload_tmux="yes"
			shift
			;;
		--uninstall)
			action="uninstall"
			shift
			;;
		-h|--help|help)
			usage
			exit 0
			;;
		*)
			printf 'setup: unknown argument: %s\n' "$1" >&2
			usage >&2
			exit 2
			;;
	esac
done

case "$target" in
	claude|codex|all)
		;;
	*)
		printf 'setup: unknown target: %s\n' "$target" >&2
		exit 2
		;;
esac

case "$status_line" in
	default|catppuccin|none)
		;;
	*)
		printf 'setup: unknown status line: %s\n' "$status_line" >&2
		exit 2
		;;
esac

prune_backups() {
	config_path="$1"
	keep=5

	count=0
	for f in "$config_path".bak.*; do
		[ -e "$f" ] || return 0
		count=$((count + 1))
	done

	remove=$((count - keep))
	[ "$remove" -le 0 ] && return 0

	i=0
	for f in "$config_path".bak.*; do
		[ -e "$f" ] || continue
		i=$((i + 1))
		if [ "$i" -le "$remove" ]; then
			rm -f "$f"
		fi
	done
}

snippet_begin="# tmux-attention: begin"
snippet_end="# tmux-attention: end"

# Back up config_path (pruning old backups), then write a copy of it with the
# managed tmux-attention block removed to tmp_path.
strip_managed_block() {
	config_path="$1"
	tmp_path="$2"

	stamp="$(date +%Y%m%d%H%M%S)"
	cp "$config_path" "$config_path.bak.$stamp"
	prune_backups "$config_path"
	awk -v begin="$snippet_begin" -v end="$snippet_end" '
		$0 == begin { skip = 1; next }
		$0 == end { skip = 0; next }
		!skip { print }
	' "$config_path" >"$tmp_path"
}

write_status_snippet() {
	config_path="$1"
	tmp_path="$(mktemp "${TMPDIR:-/tmp}/tmux-attention-setup.XXXXXX")"

	mkdir -p "$(dirname -- "$config_path")"

	if [ -f "$config_path" ]; then
		strip_managed_block "$config_path" "$tmp_path"
	else
		: >"$tmp_path"
	fi

	if [ -s "$tmp_path" ] && [ "$(tail -c 1 "$tmp_path" | wc -l | tr -d ' ')" = "0" ]; then
		printf '\n' >>"$tmp_path"
	fi

	{
		printf '%s\n' "$snippet_begin"
		case "$status_line" in
			default)
				"$SCRIPT_DIR/tmux-attention" status-format
				;;
			catppuccin)
				"$SCRIPT_DIR/tmux-attention" catppuccin-format
				;;
		esac
		printf '%s\n' "$snippet_end"
	} >>"$tmp_path"

	mv "$tmp_path" "$config_path"
	printf 'tmux config: updated (%s)\n' "$config_path"
}

remove_status_snippet() {
	config_path="$1"

	if [ ! -f "$config_path" ]; then
		printf 'tmux config: no file to update (%s)\n' "$config_path"
		return
	fi

	tmp_path="$(mktemp "${TMPDIR:-/tmp}/tmux-attention-setup.XXXXXX")"
	strip_managed_block "$config_path" "$tmp_path"

	mv "$tmp_path" "$config_path"
	printf 'tmux config: removed managed block (%s)\n' "$config_path"
}

reload_config() {
	config_path="$1"

	if ! command -v tmux >/dev/null 2>&1; then
		printf 'tmux reload: skipped (tmux not found)\n'
		return
	fi

	tmux source-file "$config_path"
	printf 'tmux reload: sourced %s\n' "$config_path"
}

if [ "$install_hooks" = "yes" ]; then
	if [ "$action" = "uninstall" ]; then
		"$SCRIPT_DIR/install-hooks" --uninstall "$target"
	else
		"$SCRIPT_DIR/install-hooks" "$target"
	fi
else
	printf 'agent hooks: skipped\n'
fi

if [ "$status_line" != "none" ]; then
	if [ "$action" = "uninstall" ]; then
		remove_status_snippet "$tmux_config"
	else
		write_status_snippet "$tmux_config"
	fi
else
	printf 'tmux config: skipped\n'
fi

if [ "$reload_tmux" = "yes" ] && [ "$status_line" != "none" ]; then
	reload_config "$tmux_config"
fi

if [ "$action" = "uninstall" ]; then
	printf '\nDone. Managed tmux-attention setup entries were removed.\n'
else
	printf '\nNext:\n'
	step=1
	if [ "$reload_tmux" = "no" ] && [ "$status_line" != "none" ]; then
		printf '  %d. Reload tmux config: tmux source-file %s\n' "$step" "$tmux_config"
		step=$((step + 1))
	fi
	if [ "$install_hooks" = "yes" ]; then
		printf '  %d. Restart Claude Code / Codex so the new hooks load. Agent hooks are read\n' "$step"
		printf '     at session start, so they will NOT fire in your current session.\n'
		step=$((step + 1))
		printf '  %d. In Claude Code or Codex, open /hooks to verify/trust the installed hooks.\n' "$step"
		step=$((step + 1))
	fi
	printf '  %d. Confirm the marker renders end to end: tmux-attention doctor --probe\n' "$step"
fi

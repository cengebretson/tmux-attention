#!/bin/sh

TMUX_ATTENTION_VERSION="$(cat "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/VERSION" 2>/dev/null || echo unknown)"

usage() {
	cat <<'EOF'
Usage: tmux-attention [input|blocked|review|done|clear] [--target <tmux-target>]
                      [--source <source>] [--reason <reason>]
       tmux-attention [--target <tmux-target>] [input|blocked|review|done|clear]
       tmux-attention event <event> [--target <tmux-target>]
                      [--source <source>] [--reason <reason>]
       tmux-attention get [--target <tmux-target>] [--format text|json]
       tmux-attention list [--session <session>] [--format text|json]
       tmux-attention turn-start --agent <name> [--project <project>]
                      [--target <tmux-target>]
       tmux-attention turn-stop [--target <tmux-target>]
       tmux-attention status-format
       tmux-attention catppuccin-format
       tmux-attention context-format
       tmux-attention doctor [--probe]
       tmux-attention version

Sets the tmux window option @agent_attention for the target tmux window.
Without --target, uses the current tmux pane. Without a state, defaults to input.
State and event writes accept optional --source and --reason metadata, stored
as window options next to the marker. Neither may contain a tab or newline
(both are used as field separators elsewhere, e.g. `list`).
Event names include approval_required, blocked, stop_failure, hook_failure,
review_required, needs_review, task_complete, session_started, plus
tool_running and tool_finished as no-ops.

turn-start marks an agent turn active for the target window and clears any
attention marker. It derives the project from the pane's Git branch/repository
or working directory unless --project is provided. turn-stop clears the agent
context only when called from the pane that started it. The plugin's
@tmux_attention_context format renders "<project> · <agent>" while active and
falls back to the current pane directory otherwise.
EOF
}

doctor() {
	probe="${1:-}"
	script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

	check_ok() {
		printf 'ok - %s\n' "$1"
	}

	check_warn() {
		printf 'warn - %s\n' "$1"
	}

	if command -v tmux >/dev/null 2>&1; then
		check_ok "tmux command is available"
	else
		check_warn "tmux command is not available"
		return 1
	fi

	if [ -n "${TMUX_PANE:-}" ]; then
		check_ok "running inside tmux"
	else
		check_warn "not running inside tmux"
	fi

	status="$(tmux show-option -gqv @tmux_attention_status 2>/dev/null || printf '')"
	case "$status" in
		*"@agent_attention"*)
			check_ok "plugin status option is loaded"
			;;
		*)
			check_warn "plugin status option is not loaded"
			;;
	esac

	configured_status="$(
		{
			tmux show-option -gqv window-status-format 2>/dev/null || true
			tmux show-option -gqv window-status-current-format 2>/dev/null || true
			tmux show-option -gqv @catppuccin_window_text 2>/dev/null || true
			tmux show-option -gqv @catppuccin_window_current_text 2>/dev/null || true
		}
	)"
	case "$configured_status" in
		*"@tmux_attention_status"*)
			check_ok "tmux status line includes tmux-attention"
			;;
		*)
			check_warn "tmux status line does not include tmux-attention"
			;;
	esac

	if command -v python3 >/dev/null 2>&1; then
		check_ok "python3 is available (needed for hook install)"
	else
		check_warn "python3 is not available (hook install/status needs it)"
	fi

	if [ ! -x "$script_dir/install-hooks" ]; then
		check_warn "install-hooks helper is missing"
	elif command -v python3 >/dev/null 2>&1; then
		"$script_dir/install-hooks" --status all
	else
		check_warn "skipping hook status (python3 not available)"
	fi

	if [ "$probe" = "--probe" ]; then
		if [ -z "${TMUX_PANE:-}" ] || ! command -v tmux >/dev/null 2>&1; then
			check_warn "marker probe skipped (not running inside tmux)"
		else
			previous="$(tmux show-options -w -t "$TMUX_PANE" -v @agent_attention 2>/dev/null || printf '')"
			tmux set-window-option -q -t "$TMUX_PANE" @agent_attention review
			rendered="$(tmux display-message -p -t "$TMUX_PANE" '#{E:@tmux_attention_status}' 2>/dev/null || printf '')"
			tmux set-window-option -q -t "$TMUX_PANE" @agent_attention "$previous"
			case "$rendered" in
				"")
					check_warn "marker probe rendered nothing (is #{E:@tmux_attention_status} in your status line?)"
					;;
				*)
					check_ok "marker probe rendered a marker for the review state: $rendered"
					;;
			esac
		fi
	fi
}

json_escape() {
	awk -v value="$1" 'BEGIN {
		gsub(/\\/, "\\\\", value)
		gsub(/"/, "\\\"", value)
		gsub(/\t/, "\\t", value)
		gsub(/\r/, "\\r", value)
		gsub(/\n/, "\\n", value)
		printf "%s", value
	}'
}

json_value() {
	if [ -n "$1" ]; then
		printf '"%s"' "$(json_escape "$1")"
	else
		printf 'null'
	fi
}

resolve_target() {
	if [ -n "$target" ]; then
		return 0
	fi

	target="${TMUX_PANE:-}"
}

require_target() {
	resolve_target
	if [ -n "$target" ]; then
		return 0
	fi

	printf 'tmux-attention: --target or TMUX_PANE is required for %s\n' "$state" >&2
	return 1
}

set_attention() {
	attention_state="$1"

	# Write all four marker options in one tmux invocation (\;-separated
	# commands): these run on every hook event, so avoid four round trips.
	case "$attention_state" in
		clear|none|off)
			tmux set-window-option -q -t "$target" @agent_attention '' \; \
				set-window-option -q -t "$target" @agent_attention_source '' \; \
				set-window-option -q -t "$target" @agent_attention_reason '' \; \
				set-window-option -q -t "$target" @agent_attention_updated_at ''
			return 0
			;;
	esac

	tmux set-window-option -q -t "$target" @agent_attention "$attention_state" \; \
		set-window-option -q -t "$target" @agent_attention_source "$source" \; \
		set-window-option -q -t "$target" @agent_attention_reason "$reason" \; \
		set-window-option -q -t "$target" @agent_attention_updated_at "$(date +%s)"
}

get_option() {
	tmux show-options -wqv -t "$target" "$1" 2>/dev/null || printf ''
}

derive_project() {
	context_path="$1"
	context_root=""
	context_branch=""
	context_ticket=""

	if command -v git >/dev/null 2>&1; then
		context_root="$(git -C "$context_path" rev-parse --show-toplevel 2>/dev/null || printf '')"
		context_branch="$(git -C "$context_path" symbolic-ref --quiet --short HEAD 2>/dev/null || printf '')"
	fi

	if [ -n "$context_branch" ] && command -v awk >/dev/null 2>&1; then
		context_ticket="$(
			printf '%s\n' "$context_branch" |
				awk 'match($0, /[[:upper:]][[:upper:][:digit:]]*-[[:digit:]]+/) {
					print substr($0, RSTART, RLENGTH)
					exit
				}'
		)"
	fi

	if [ -n "$context_ticket" ]; then
		printf '%s\n' "$context_ticket"
	elif [ -n "$context_root" ]; then
		printf '%s\n' "${context_root##*/}"
	else
		context_path="${context_path%/}"
		printf '%s\n' "${context_path##*/}"
	fi
}

set_turn_start() {
	context_fields="$(tmux display-message -p -t "$target" "#{pane_id}	#{pane_current_path}" 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}
	context_tab="$(printf '\t')"
	context_pane="${context_fields%%"$context_tab"*}"
	context_path="${context_fields#*"$context_tab"}"

	if [ -z "$project" ]; then
		project="$(derive_project "$context_path")"
	fi

	# A submitted prompt both begins the active turn and resolves any previous
	# input marker. Keep this to one tmux round trip because every prompt uses it.
	tmux set-window-option -q -t "$target" @agent_attention '' \; \
		set-window-option -q -t "$target" @agent_attention_source '' \; \
		set-window-option -q -t "$target" @agent_attention_reason '' \; \
		set-window-option -q -t "$target" @agent_attention_updated_at '' \; \
		set-window-option -q -t "$target" @agent_context_active '1' \; \
		set-window-option -q -t "$target" @agent_context_name "$agent" \; \
		set-window-option -q -t "$target" @agent_context_project "$project" \; \
		set-window-option -q -t "$target" @agent_context_pane "$context_pane" \; \
		set-window-option -q -t "$target" @agent_context_updated_at "$(date +%s)"
}

set_turn_stop() {
	context_pane="$(tmux display-message -p -t "$target" '#{pane_id}' 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}
	context_owner="$(get_option @agent_context_pane)"

	# A stale Stop from another pane must not clear a newer agent in this
	# window. The plugin remains window-scoped, but the owning pane controls the
	# lifecycle of its context.
	if [ -n "$context_owner" ] && [ "$context_owner" != "$context_pane" ]; then
		return 0
	fi

	tmux set-window-option -q -t "$target" @agent_context_active '' \; \
		set-window-option -q -t "$target" @agent_context_name '' \; \
		set-window-option -q -t "$target" @agent_context_project '' \; \
		set-window-option -q -t "$target" @agent_context_pane '' \; \
		set-window-option -q -t "$target" @agent_context_updated_at ''
}

print_get() {
	if ! require_target; then
		return 1
	fi

	window_id="$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}
	state_value="$(get_option @agent_attention)"
	source_value="$(get_option @agent_attention_source)"
	reason_value="$(get_option @agent_attention_reason)"
	updated_at_value="$(get_option @agent_attention_updated_at)"

	case "$format" in
		text)
			if [ -n "$state_value" ]; then
				printf '%s\n' "$state_value"
			fi
			;;
		json)
			printf '{"scope":"window","target":'
			json_value "$window_id"
			printf ',"state":'
			json_value "$state_value"
			printf ',"source":'
			json_value "$source_value"
			printf ',"reason":'
			json_value "$reason_value"
			printf ',"updated_at":'
			json_value "$updated_at_value"
			printf '}\n'
			;;
	esac
}

print_list() {
	tab="$(printf '\t')"
	if [ -n "$session" ]; then
		list_output="$(tmux list-windows -t "$session" -F "#{session_name}${tab}#{window_index}${tab}#{window_id}${tab}#{window_name}${tab}#{@agent_attention}${tab}#{@agent_attention_source}${tab}#{@agent_attention_reason}${tab}#{@agent_attention_updated_at}" 2>/dev/null)" || {
			printf 'tmux-attention: invalid session: %s\n' "$session" >&2
			return 1
		}
	else
		list_output="$(tmux list-windows -a -F "#{session_name}${tab}#{window_index}${tab}#{window_id}${tab}#{window_name}${tab}#{@agent_attention}${tab}#{@agent_attention_source}${tab}#{@agent_attention_reason}${tab}#{@agent_attention_updated_at}" 2>/dev/null)" || return 1
	fi

	case "$format" in
		text)
			printf '%s\n' "$list_output" | while IFS="$(printf '\t')" read -r session_name window_index _window_id _window_name state_value _source_value _reason_value _updated_at_value; do
				if [ -n "$state_value" ]; then
					printf '%s:%s %s\n' "$session_name" "$window_index" "$state_value"
				fi
			done
			;;
		json)
			printf '['
			first="true"
			printf '%s\n' "$list_output" | while IFS="$(printf '\t')" read -r session_name window_index window_id window_name state_value source_value reason_value updated_at_value; do
				if [ -z "$state_value" ]; then
					continue
				fi
				if [ "$first" = "true" ]; then
					first="false"
				else
					printf ','
				fi
				printf '{"session":'
				json_value "$session_name"
				printf ',"window_index":'
				json_value "$window_index"
				printf ',"window_id":'
				json_value "$window_id"
				printf ',"window_name":'
				json_value "$window_name"
				printf ',"state":'
				json_value "$state_value"
				printf ',"source":'
				json_value "$source_value"
				printf ',"reason":'
				json_value "$reason_value"
				printf ',"updated_at":'
				json_value "$updated_at_value"
				printf '}'
			done
			printf ']\n'
			;;
	esac
}

state="input"
state_set="false"
target=""
doctor_probe=""
format="text"
session=""
source=""
reason=""
event_type=""
agent=""
project=""

while [ "$#" -gt 0 ]; do
	case "$1" in
		--target|-t)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --target requires a tmux target\n' >&2
				usage >&2
				exit 2
			fi
			target="$2"
			shift 2
			;;
		--target=*)
			target="${1#--target=}"
			if [ -z "$target" ]; then
				printf 'tmux-attention: --target requires a tmux target\n' >&2
				usage >&2
				exit 2
			fi
			shift
			;;
		--format)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --format requires text or json\n' >&2
				usage >&2
				exit 2
			fi
			format="$2"
			shift 2
			;;
		--format=*)
			format="${1#--format=}"
			shift
			;;
		--session)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --session requires a tmux session\n' >&2
				usage >&2
				exit 2
			fi
			session="$2"
			shift 2
			;;
		--session=*)
			session="${1#--session=}"
			shift
			;;
		--source)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --source requires a value\n' >&2
				usage >&2
				exit 2
			fi
			source="$2"
			shift 2
			;;
		--source=*)
			source="${1#--source=}"
			shift
			;;
		--reason)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --reason requires a value\n' >&2
				usage >&2
				exit 2
			fi
			reason="$2"
			shift 2
			;;
		--reason=*)
			reason="${1#--reason=}"
			shift
			;;
		--agent)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --agent requires a value\n' >&2
				usage >&2
				exit 2
			fi
			agent="$2"
			shift 2
			;;
		--agent=*)
			agent="${1#--agent=}"
			shift
			;;
		--project)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --project requires a value\n' >&2
				usage >&2
				exit 2
			fi
			project="$2"
			shift 2
			;;
		--project=*)
			project="${1#--project=}"
			shift
			;;
		--probe)
			case "$state" in
				doctor|check)
					doctor_probe="--probe"
					shift
					;;
				*)
					printf 'tmux-attention: unexpected argument: %s\n' "$1" >&2
					usage >&2
					exit 2
					;;
			esac
			;;
		*)
			if [ "$state_set" = "true" ]; then
				if [ "$state" = "event" ] && [ -z "$event_type" ]; then
					event_type="$1"
					shift
					continue
				else
					printf 'tmux-attention: unexpected argument: %s\n' "$1" >&2
					usage >&2
					exit 2
				fi
			fi
			state="$1"
			state_set="true"
			shift
			;;
	esac
done

_tab_char="$(printf '\t')"
_nl_char="$(printf '\nX')"; _nl_char="${_nl_char%X}"

case "$source" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --source must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$reason" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --reason must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$agent" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --agent must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$project" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --project must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$format" in
	text|json)
		;;
	*)
		printf 'tmux-attention: unknown format: %s\n' "$format" >&2
		usage >&2
		exit 2
		;;
esac

case "$state" in
	input|blocked|review|done|clear|none|off)
		;;
	event)
		if [ -z "$event_type" ]; then
			printf 'tmux-attention: event requires an event name\n' >&2
			usage >&2
			exit 2
		fi
		;;
	get|list|turn-stop)
		;;
	turn-start)
		if [ -z "$agent" ]; then
			printf 'tmux-attention: turn-start requires --agent\n' >&2
			usage >&2
			exit 2
		fi
		;;
	status-format|format)
		cat <<'EOF'
set -g window-status-format "#{E:@tmux_attention_status}#I:#W"
set -g window-status-current-format "#{E:@tmux_attention_status}#I:#W"
EOF
		exit 0
		;;
	catppuccin-format|catppuccin)
		cat <<'EOF'
set -g @catppuccin_window_text "#{E:@tmux_attention_status}#W"
set -g @catppuccin_window_current_text "#{E:@tmux_attention_status}#W"
EOF
		exit 0
		;;
	context-format|context)
		printf '%s\n' '#{E:@tmux_attention_context}'
		exit 0
		;;
	doctor|check)
		doctor "$doctor_probe"
		exit "$?"
		;;
	version|--version|-v)
		printf 'tmux-attention %s\n' "$TMUX_ATTENTION_VERSION"
		exit 0
		;;
	-h|--help|help)
		usage
		exit 0
		;;
	*)
		printf 'tmux-attention: unknown state: %s\n' "$state" >&2
		usage >&2
		exit 2
		;;
esac

case "$state" in
	get)
		if ! command -v tmux >/dev/null 2>&1; then
			printf 'tmux-attention: tmux command is not available\n' >&2
			exit 1
		fi
		print_get
		exit $?
		;;
	list)
		if ! command -v tmux >/dev/null 2>&1; then
			printf 'tmux-attention: tmux command is not available\n' >&2
			exit 1
		fi
		print_list
		exit $?
		;;
esac

if [ "$state" = "event" ]; then
	case "$event_type" in
		approval_required)
			state="input"
			: "${reason:=approval_required}"
			;;
		task_complete)
			state="done"
			: "${reason:=task_complete}"
			;;
		session_started)
			state="clear"
			: "${reason:=session_started}"
			;;
		tool_running|tool_finished)
			exit 0
			;;
		blocked|stop_failure|hook_failure)
			state="blocked"
			: "${reason:=$event_type}"
			;;
		review_required|needs_review)
			state="review"
			: "${reason:=$event_type}"
			;;
		*)
			printf 'tmux-attention: unknown event: %s\n' "$event_type" >&2
			usage >&2
			exit 2
			;;
	esac
	: "${source:=event}"
fi

if ! command -v tmux >/dev/null 2>&1; then
	printf '\a'
	exit 0
fi

resolve_target

if [ -z "$target" ]; then
	printf '\a'
	exit 0
fi

case "$state" in
	turn-start)
		set_turn_start
		exit $?
		;;
	turn-stop)
		set_turn_stop
		exit $?
		;;
esac

set_attention "$state"

case "$state" in
	clear|none|off)
		exit 0
		;;
esac

# One display-message round trip for both flags; split on the space.
attached_active="$(tmux display-message -p -t "$target" '#{session_attached} #{window_active}' 2>/dev/null || printf '0 0')"
attached="${attached_active% *}"
active="${attached_active#* }"

if [ "$attached" != "0" ] && [ "$active" = "1" ]; then
	script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
	"$script_dir/clear-after-delay" "$target"
fi

#!/bin/sh

# Resolve this script through any symlinks before locating files beside it.
# Symlinking the CLI onto PATH is a normal install, and dirname "$0" then points
# at the link's directory -- so VERSION and shell-init's self-reference would
# resolve next to the symlink instead of next to the plugin. readlink -f is not
# portable, hence the loop.
tmux_attention_dir() {
	_self="$0"
	while [ -L "$_self" ]; do
		_link="$(readlink "$_self")"
		case "$_link" in
			/*) _self="$_link" ;;
			*) _self="$(dirname -- "$_self")/$_link" ;;
		esac
	done
	CDPATH= cd -- "$(dirname -- "$_self")" && pwd -P
}

TMUX_ATTENTION_DIR="$(tmux_attention_dir)"
TMUX_ATTENTION_VERSION="$(cat "$TMUX_ATTENTION_DIR/../VERSION" 2>/dev/null || echo unknown)"

usage() {
	cat <<'EOF'
Usage: tmux-attention [input|blocked|review|done|clear] [--target <tmux-target>]
                      [--source <source>] [--reason <reason>]
       tmux-attention [--target <tmux-target>] [input|blocked|review|done|clear]
       tmux-attention event <event> [--target <tmux-target>]
                      [--source <source>] [--reason <reason>]
       tmux-attention get [--target <tmux-target>] [--format text|json]
       tmux-attention list [--session <session>] [--format text|json]
       tmux-attention turn-start [--project <project>] [--target <tmux-target>]
       tmux-attention turn-active [--project <project>] [--target <tmux-target>]
       tmux-attention turn-stop [--target <tmux-target>]
       tmux-attention turn-done [--target <tmux-target>]
                                [--source <source>] [--reason <reason>]
       tmux-attention project set <project> [--target <tmux-target>]
       tmux-attention project clear [--target <tmux-target>]
       tmux-attention refresh [--target <tmux-target>]
       tmux-attention claim --owner <id> [--target <tmux-target>]
       tmux-attention disown [--target <tmux-target>]
       tmux-attention shell-init <fish|bash|zsh> [command...]
       tmux-attention status-format
       tmux-attention catppuccin-format
       tmux-attention context-format
       tmux-attention doctor [--probe]
       tmux-attention version

Sets pane-local agent state for the target tmux pane and derives a summary for
its window.
Without --target, uses the current tmux pane. Without a state, defaults to input.
State and event writes accept optional --source and --reason metadata, stored
as pane options next to the marker. Neither may contain a tab or newline
(both are used as field separators elsewhere, e.g. `list`).
Event names include approval_required, blocked, stop_failure, hook_failure,
review_required, needs_review, task_complete, session_started, plus
tool_running and tool_finished as no-ops.

turn-start marks an agent turn active for the target pane and clears that
pane's attention marker. It derives the project from the pane's Git
branch/repository or working directory unless --project is provided. turn-stop
clears only the target pane's agent context. Multiple panes in one window can
therefore track agents independently. The plugin's @tmux_attention_context
format renders the most recently active project while any pane is working and
falls back to the current pane directory otherwise.

turn-active idempotently restores a missing active-turn context. It is intended
for activity hooks that may run repeatedly: an already-active pane is left
untouched, while an inactive pane follows the same transition as turn-start.

turn-done atomically clears the target pane's active-turn context and sets its
done attention marker. Its default source is turn and its default reason is
response_ready. Use it when an agent Stop event means a completed response is
ready for the user, rather than that an entire project or conversation ended.

project set stores a pane-local project override that survives turn boundaries.
Future turn-start/turn-active calls use it before Git branch, repository, or
directory inference, and the idle status label keeps showing it between turns.
project clear returns the pane to automatic inference. Pane claim/disown also
clear the override so a recycled pane cannot inherit another agent's ticket.

claim stamps a pane with an owner id and clears any marker it inherited, so a
new agent never starts wearing the previous occupant's state. A launcher runs it
and gives the agent the same id, via --owner or TMUX_ATTENTION_OWNER. A write
whose id disagrees with the pane's is then refused, which is what stops a dead
agent's late hook, or the previous occupant of a recycled pane, from leaving a
marker that looks live. disown removes the stamp.

Ownership is optional and only a mismatch refuses: a caller presenting no id
still writes, recorded as unverified, so ad-hoc panes and manual use are
unaffected. It guards against staleness and accidents, not against a determined
writer -- anyone who can run tmux can set the option too.

shell-init prints shell integration to eval. It always defines
tmux_attention_claim and tmux_attention_disown, and emits a full wrapper only
for commands named after the shell:

  tmux-attention shell-init fish | source          # helpers only
  tmux-attention shell-init fish claude codex      # helpers + wrappers
  eval "\$(tmux-attention shell-init bash claude)" # bash/zsh

Wrapping is opt-in because replacing a command someone already wraps would
silently drop what their version did; those users call the two helpers from the
wrapper they already have. The owner id must reach the agent's environment at
launch -- a hook reading it back off the pane would let a dead agent's late hook
match the pane's current owner, which is the case ownership exists to catch.
EOF
}

doctor() {
	probe="${1:-}"
	script_dir="$TMUX_ATTENTION_DIR"

	check_ok() {
		printf 'ok - %s\n' "$1"
	}

	check_warn() {
		printf 'warn - %s\n' "$1"
	}

	if command -v tmux >/dev/null 2>&1; then
		check_ok "tmux command is available"
	else
		check_warn "tmux command is not available"
		return 1
	fi

	if [ -n "${TMUX_PANE:-}" ]; then
		check_ok "running inside tmux"
	else
		check_warn "not running inside tmux"
	fi

	status="$(tmux show-option -gqv @tmux_attention_status 2>/dev/null || printf '')"
	case "$status" in
		*"@agent_attention"*)
			check_ok "plugin status option is loaded"
			;;
		*)
			check_warn "plugin status option is not loaded"
			;;
	esac

	configured_status="$(
		{
			tmux show-option -gqv window-status-format 2>/dev/null || true
			tmux show-option -gqv window-status-current-format 2>/dev/null || true
			tmux show-option -gqv @catppuccin_window_text 2>/dev/null || true
			tmux show-option -gqv @catppuccin_window_current_text 2>/dev/null || true
		}
	)"
	case "$configured_status" in
		*"@tmux_attention_status"*|*"@tmux_attention_tab_icon"*|*"@tmux_attention_context"*)
			check_ok "tmux status line includes tmux-attention"
			;;
		*)
			check_warn "tmux status line does not include tmux-attention"
			;;
	esac

	if command -v python3 >/dev/null 2>&1; then
		check_ok "python3 is available (needed for hook install)"
	else
		check_warn "python3 is not available (hook install/status needs it)"
	fi

	dispatcher_hooks_active() {
		integration="$1"
		config_path="$2"
		config_dir="${config_path%/*}"
		handler_dir="$config_dir/hooks/handlers"

		[ -f "$config_path" ] || return 1
		grep -q 'dispatch\.sh' "$config_path" 2>/dev/null || return 1
		grep -q 'prompt-clear' "$config_path" 2>/dev/null || return 1
		grep -q 'agent-turn-stop' "$config_path" 2>/dev/null || return 1
		[ -x "$handler_dir/prompt-clear" ] || return 1
		[ -x "$handler_dir/agent-turn-stop" ] || return 1
		grep -q 'turn-start' "$handler_dir/prompt-clear" 2>/dev/null || return 1
		grep -q 'turn-done' "$handler_dir/agent-turn-stop" 2>/dev/null || return 1

		if [ "$integration" = "codex" ]; then
			grep -q 'agent-turn-active' "$config_path" 2>/dev/null || return 1
			[ -x "$handler_dir/agent-turn-active" ] || return 1
			grep -q 'turn-active' "$handler_dir/agent-turn-active" 2>/dev/null || return 1
		fi
	}

	if [ ! -x "$script_dir/install-hooks" ]; then
		check_warn "install-hooks helper is missing"
	elif command -v python3 >/dev/null 2>&1; then
		claude_settings="${TMUX_ATTENTION_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
		codex_hooks="${TMUX_ATTENTION_CODEX_HOOKS:-${CODEX_HOME:-$HOME/.codex}/hooks.json}"
		hook_status="$("$script_dir/install-hooks" --status all)"
		printf '%s\n' "$hook_status" | while IFS= read -r hook_line; do
			case "$hook_line" in
				"claude: not installed"*)
					if dispatcher_hooks_active claude "$claude_settings"; then
						check_ok "claude hooks installed through dispatcher"
					else
						printf '%s\n' "$hook_line"
					fi
					;;
				"codex: not installed"*)
					if dispatcher_hooks_active codex "$codex_hooks"; then
						check_ok "codex hooks installed through dispatcher"
					else
						printf '%s\n' "$hook_line"
					fi
					;;
				*) printf '%s\n' "$hook_line" ;;
			esac
		done
	else
		check_warn "skipping hook status (python3 not available)"
	fi

	if [ "$probe" = "--probe" ]; then
		if [ -z "${TMUX_PANE:-}" ] || ! command -v tmux >/dev/null 2>&1; then
			check_warn "marker probe skipped (not running inside tmux)"
		else
			previous="$(tmux show-options -p -t "$TMUX_PANE" -v @agent_pane_attention 2>/dev/null || printf '')"
			tmux set-option -pq -t "$TMUX_PANE" @agent_pane_attention review
			previous_target="$target"
			target="$TMUX_PANE"
			recompute_window_summary
			rendered="$(tmux display-message -p -t "$TMUX_PANE" '#{E:@tmux_attention_status}' 2>/dev/null || printf '')"
			tmux set-option -pq -t "$TMUX_PANE" @agent_pane_attention "$previous"
			recompute_window_summary
			target="$previous_target"
			case "$rendered" in
				"")
					check_warn "marker probe rendered nothing (is #{E:@tmux_attention_status} in your status line?)"
					;;
				*)
					check_ok "marker probe rendered a marker for the review state: $rendered"
					;;
			esac
		fi
	fi
}

json_escape() {
	awk -v value="$1" 'BEGIN {
		gsub(/\\/, "\\\\", value)
		gsub(/"/, "\\\"", value)
		gsub(/\t/, "\\t", value)
		gsub(/\r/, "\\r", value)
		gsub(/\n/, "\\n", value)
		printf "%s", value
	}'
}

json_value() {
	if [ -n "$1" ]; then
		printf '"%s"' "$(json_escape "$1")"
	else
		printf 'null'
	fi
}

resolve_target() {
	if [ -n "$target" ]; then
		return 0
	fi

	target="${TMUX_PANE:-}"
}

require_target() {
	resolve_target
	if [ -n "$target" ]; then
		return 0
	fi

	printf 'tmux-attention: --target or TMUX_PANE is required for %s\n' "$state" >&2
	return 1
}

set_attention() {
	attention_state="$1"

	# Write all four marker options in one tmux invocation (\;-separated
	# commands): these run on every hook event, so avoid four round trips.
	case "$attention_state" in
		clear|none|off)
			tmux set-option -pq -t "$target" @agent_pane_attention '' \; \
				set-option -pq -t "$target" @agent_pane_attention_source '' \; \
				set-option -pq -t "$target" @agent_pane_attention_reason '' \; \
				set-option -pq -t "$target" @agent_pane_attention_updated_at '' \; \
				set-option -pq -t "$target" @agent_pane_attention_verified ''
			recompute_window_summary
			return $?
			;;
	esac

	tmux set-option -pq -t "$target" @agent_pane_attention "$attention_state" \; \
		set-option -pq -t "$target" @agent_pane_attention_source "$source" \; \
		set-option -pq -t "$target" @agent_pane_attention_reason "$reason" \; \
		set-option -pq -t "$target" @agent_pane_attention_updated_at "$(date +%s)" \; \
		set-option -pq -t "$target" @agent_pane_attention_verified "$write_verified"
	recompute_window_summary
}

get_pane_option() {
	tmux show-options -pqv -t "$target" "$1" 2>/dev/null || printf ''
}

# Ownership is an optional staleness guard, not a security boundary.
#
# A launcher stamps a pane with `claim <id>` and hands the same id to the agent
# it starts (via --owner or TMUX_ATTENTION_OWNER). A write whose id disagrees
# with the pane's is refused, which is what stops a dead agent's late hook -- or
# the previous occupant of a recycled pane -- from leaving a marker that looks
# live. Anyone who can run tmux can also set the option, so this catches
# accidents and staleness, never a determined writer.
#
# Only a *mismatch* refuses. A caller presenting no id is allowed through
# unverified, which keeps ad-hoc panes and manual `tmux-attention clear` working
# exactly as before.
owner_matches() {
	pane_owner="$(get_pane_option @agent_pane_owner)"
	if [ -z "$pane_owner" ]; then
		write_verified=""
		return 0
	fi
	if [ -z "$owner" ]; then
		write_verified=""
		return 0
	fi
	if [ "$owner" = "$pane_owner" ]; then
		write_verified="1"
		return 0
	fi
	printf 'tmux-attention: refusing write to %s: owner %s does not match pane owner %s\n' \
		"$target" "$owner" "$pane_owner" >&2
	return 1
}

claim_pane() {
	if [ -z "$owner" ]; then
		printf 'tmux-attention: claim requires --owner or TMUX_ATTENTION_OWNER\n' >&2
		return 2
	fi
	# Clear any inherited marker as the pane changes hands, so a new agent never
	# starts life wearing the previous occupant's state.
	tmux set-option -pq -t "$target" @agent_pane_owner "$owner" \; \
		set-option -pq -t "$target" @agent_pane_attention '' \; \
		set-option -pq -t "$target" @agent_pane_attention_source '' \; \
		set-option -pq -t "$target" @agent_pane_attention_reason '' \; \
		set-option -pq -t "$target" @agent_pane_attention_updated_at '' \; \
		set-option -pq -t "$target" @agent_pane_attention_verified '' \; \
		set-option -pq -t "$target" @agent_pane_context_override ''
	recompute_window_summary
}

# Shell integration.
#
# Ownership needs the owner id frozen into the agent's environment at launch:
# if a later hook read it back off the pane instead, a dead agent's late hook
# would read the *current* owner and match, which is the thing ownership exists
# to prevent. So something has to wrap the launch, and only the shell can.
#
# Two functions are always emitted, and a full wrapper only for commands named
# explicitly. Wrapping is opt-in because a user may already wrap `claude` for
# their own reasons -- a window rename, a different binary -- and silently
# replacing that function would lose it. Those users compose the helpers into
# the wrapper they already have.
shell_init_self() {
	printf '%s' "$TMUX_ATTENTION_DIR"
}

shell_init_posix() {
	cli="$1"
	cat <<EOF
# tmux-attention shell integration. Regenerate with:
#   tmux-attention shell-init $shell_name$wrap_commands
_tmux_attention_cli() {
	[ -n "\${TMUX:-}" ] || return 1
	[ -x "$cli" ] || return 1
	printf '%s' "$cli"
}

# Claim the current pane for one agent launch and echo the owner id. Export it
# as TMUX_ATTENTION_OWNER for the command being launched.
tmux_attention_claim() {
	_tac="\$(_tmux_attention_cli)" || return 1
	_tao="\${1:-agent}-\$\$-\${RANDOM:-0}"
	"\$_tac" claim --owner "\$_tao" >/dev/null 2>&1 || return 1
	printf '%s' "\$_tao"
}

tmux_attention_disown() {
	_tac="\$(_tmux_attention_cli)" || return 0
	"\$_tac" disown >/dev/null 2>&1 || true
}
EOF
	for command in $wrap_commands; do
		cat <<EOF

$command() {
	_tao="\$(tmux_attention_claim $command)" || { command $command "\$@"; return \$?; }
	TMUX_ATTENTION_OWNER="\$_tao" command $command "\$@"
	_tas=\$?
	tmux_attention_disown
	return \$_tas
}
EOF
	done
}

shell_init_fish() {
	cli="$1"
	cat <<EOF
# tmux-attention shell integration. Regenerate with:
#   tmux-attention shell-init $shell_name$wrap_commands
function _tmux_attention_cli --description 'Path to a usable tmux-attention CLI'
	set -q TMUX; or return 1
	test -x "$cli"; or return 1
	echo "$cli"
end

function tmux_attention_claim --description 'Claim this pane for one agent launch'
	set -l cli (_tmux_attention_cli); or return 1
	set -l owner (string join -- '-' (test -n "\$argv[1]"; and echo \$argv[1]; or echo agent) \$fish_pid (random))
	\$cli claim --owner \$owner >/dev/null 2>&1; or return 1
	echo \$owner
end

function tmux_attention_disown --description 'Release this pane after an agent exits'
	set -l cli (_tmux_attention_cli); or return 0
	\$cli disown >/dev/null 2>&1
	return 0
end
EOF
	for command in $wrap_commands; do
		cat <<EOF

function $command --wraps=$command --description '$command with tmux-attention pane ownership'
	set -l owner (tmux_attention_claim $command)
	if test -z "\$owner"
		command $command \$argv
		return \$status
	end
	set -x TMUX_ATTENTION_OWNER \$owner
	command $command \$argv
	set -l agent_status \$status
	tmux_attention_disown
	return \$agent_status
end
EOF
	done
}

shell_init() {
	cli="$(shell_init_self)/tmux-attention"
	case "$shell_name" in
		fish) shell_init_fish "$cli" ;;
		bash|zsh|sh) shell_init_posix "$cli" ;;
		'')
			printf 'tmux-attention: shell-init requires a shell: fish, bash, or zsh\n' >&2
			return 2
			;;
		*)
			printf 'tmux-attention: unsupported shell: %s (fish, bash, zsh)\n' "$shell_name" >&2
			return 2
			;;
	esac
}

disown_pane() {
	# The verified flag means "written by the pane's owner", so it cannot
	# outlive the stamp -- a marker claiming verification with nothing to have
	# verified it against is worse than an unverified one.
	tmux set-option -pq -t "$target" @agent_pane_owner '' \; \
		set-option -pq -t "$target" @agent_pane_attention_verified '' \; \
		set-option -pq -t "$target" @agent_pane_context_override ''
	recompute_window_summary
}

recompute_window_summary() {
	window_id="$(tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}
	tab="$(printf '\t')"
	pane_rows="$(tmux list-panes -t "$window_id" -F "#{pane_id}${tab}#{@agent_pane_attention}${tab}#{@agent_pane_attention_source}${tab}#{@agent_pane_attention_reason}${tab}#{@agent_pane_attention_updated_at}${tab}#{@agent_pane_context_active}${tab}#{@agent_pane_context_project}${tab}#{@agent_pane_context_updated_at}${tab}#{@agent_pane_activity}${tab}#{@agent_pane_context_specific}" 2>/dev/null)" || return 1

	attention_row="$(
		printf '%s\n' "$pane_rows" |
			awk -F '\t' '
				function rank(state) {
					if (state == "input") return 4
					if (state == "blocked") return 3
					if (state == "review") return 2
					if (state == "done") return 1
					return 0
				}
				{
					state_rank = rank($2)
					if (state_rank > best_rank || (state_rank == best_rank && state_rank > 0 && ($5 + 0) > best_time)) {
						best_rank = state_rank
						best_time = $5 + 0
						best_state = $2
						best_source = $3
						best_reason = $4
						best_updated_at = $5
					}
				}
				END {
					if (best_rank > 0) printf "%s\n%s\n%s\n%s\n", best_state, best_source, best_reason, best_updated_at
				}
			'
	)"
	attention_state=""
	attention_source=""
	attention_reason=""
	attention_updated_at=""
	if [ -n "$attention_row" ]; then
		attention_state="$(printf '%s\n' "$attention_row" | sed -n '1p')"
		attention_source="$(printf '%s\n' "$attention_row" | sed -n '2p')"
		attention_reason="$(printf '%s\n' "$attention_row" | sed -n '3p')"
		attention_updated_at="$(printf '%s\n' "$attention_row" | sed -n '4p')"
	fi

	context_row="$(
		printf '%s\n' "$pane_rows" |
			awk -F '\t' '$6 == "1" && ($8 + 0) >= best_time {
				best_time = $8 + 0
				best_project = $7
				best_pane = $1
				best_updated_at = $8
				best_activity = $9
				best_specific = $10
			}
			END {
				if (best_pane != "") printf "%s\n%s\n%s\n%s\n%s\n", best_project, best_pane, best_updated_at, best_activity, best_specific
			}'
	)"
	context_active=""
	context_project=""
	context_activity=""
	context_pane=""
	context_updated_at=""
	context_specific=""
	if [ -n "$context_row" ]; then
		context_active="1"
		context_project="$(printf '%s\n' "$context_row" | sed -n '1p')"
		context_pane="$(printf '%s\n' "$context_row" | sed -n '2p')"
		context_updated_at="$(printf '%s\n' "$context_row" | sed -n '3p')"
		context_activity="$(printf '%s\n' "$context_row" | sed -n '4p')"
		context_specific="$(printf '%s\n' "$context_row" | sed -n '5p')"
	fi

	# Idle label: what to show when no agent turn is active. Derived from the window's
	# ACTIVE pane rather than the agent pane, because with no turn running the thing the
	# user is looking at is the active pane. Recomputed on the same hooks as the rest of
	# this summary, so it tracks branch and directory changes as soon as the window is
	# focused again. Falls back inside `derive_project_details` to the repo name, then the
	# directory name, so it is never empty for a real pane.
	idle_fields="$(tmux display-message -p -t "$window_id" "#{pane_current_path}${tab}#{@agent_pane_context_override}" 2>/dev/null || printf '')"
	idle_path="${idle_fields%%"$tab"*}"
	idle_override="${idle_fields#*"$tab"}"
	idle_project=""
	idle_specific=""
	if [ -n "$idle_override" ]; then
		idle_project="$idle_override"
		idle_specific="1"
	elif [ -n "$idle_path" ]; then
		idle_details="$(derive_project_details "$idle_path")"
		idle_project="$(printf '%s\n' "$idle_details" | sed -n '1p')"
		idle_specific="$(printf '%s\n' "$idle_details" | sed -n '2p')"
	fi

	# These window options are a derived compatibility/status summary. Pane
	# options above remain authoritative when more than one agent shares a window.
	tmux set-window-option -q -t "$window_id" @agent_attention "$attention_state" \; \
		set-window-option -q -t "$window_id" @agent_attention_source "$attention_source" \; \
		set-window-option -q -t "$window_id" @agent_attention_reason "$attention_reason" \; \
		set-window-option -q -t "$window_id" @agent_attention_updated_at "$attention_updated_at" \; \
		set-window-option -q -t "$window_id" @agent_context_active "$context_active" \; \
		set-window-option -q -t "$window_id" @agent_context_project "$context_project" \; \
		set-window-option -q -t "$window_id" @agent_context_pane "$context_pane" \; \
		set-window-option -q -t "$window_id" @agent_context_updated_at "$context_updated_at" \; \
		set-window-option -q -t "$window_id" @agent_context_specific "$context_specific" \; \
		set-window-option -q -t "$window_id" @agent_context_idle_project "$idle_project" \; \
		set-window-option -q -t "$window_id" @agent_context_idle_specific "$idle_specific" \; \
		set-window-option -q -t "$window_id" @agent_context_activity "$context_activity"
}

derive_project_details() {
	context_path="$1"
	context_root=""
	context_branch=""
	context_ticket=""
	context_specific=""

	if command -v git >/dev/null 2>&1; then
		context_root="$(git -C "$context_path" rev-parse --show-toplevel 2>/dev/null || printf '')"
		context_branch="$(git -C "$context_path" symbolic-ref --quiet --short HEAD 2>/dev/null || printf '')"
	fi

	if [ -n "$context_branch" ] && command -v awk >/dev/null 2>&1; then
		context_ticket="$(
			printf '%s\n' "$context_branch" |
				awk 'match($0, /[[:upper:]][[:upper:][:digit:]]*-[[:digit:]]+/) {
					print substr($0, RSTART, RLENGTH)
					exit
				}'
		)"
	fi

	# Optional suffixes. Both are read from global tmux options so a user can turn them off
	# without patching the plugin, and both are appended only to a label we derived
	# ourselves: an explicit `turn-start --project` value is passed through untouched.
	context_suffix=""

	# Dirty marker: a one-character hint that the tree has uncommitted changes. Uses
	# --quiet with an exit status rather than parsing porcelain output, so it stays a
	# single cheap call on an already-warm git index.
	if [ -n "$context_root" ]; then
		dirty_marker="$(tmux show-option -gqv @tmux_attention_dirty_marker 2>/dev/null || printf '')"
		if [ -z "$dirty_marker" ]; then
			dirty_marker="*"
		elif [ "$dirty_marker" = "off" ]; then
			dirty_marker=""
		fi
		if [ -n "$dirty_marker" ] && ! git -C "$context_path" diff --quiet HEAD 2>/dev/null; then
			context_suffix="$dirty_marker"
		fi
	fi

	# Worktree hint: opt-in, because two linked worktrees on branches sharing a ticket
	# render identically otherwise. Deliberately keyed on "is this a linked worktree"
	# rather than on a cross-window collision scan: a scan result depends on the order
	# windows happen to refresh, so labels would flap as you moved around.
	context_linked_worktree=""
	if [ -n "$context_root" ]; then
		git_dir="$(git -C "$context_path" rev-parse --absolute-git-dir 2>/dev/null || printf '')"
		common_dir="$(git -C "$context_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || printf '')"
		if [ -n "$git_dir" ] && [ -n "$common_dir" ] && [ "$git_dir" != "$common_dir" ]; then
			context_linked_worktree="1"
			if [ "$(tmux show-option -gqv @tmux_attention_worktree_hint 2>/dev/null || printf '')" = "on" ]; then
				context_suffix="$context_suffix@${context_root##*/}"
			fi
		fi
	fi

	if [ -n "$context_ticket" ]; then
		context_label="$context_ticket$context_suffix"
		context_specific="1"
	elif [ -n "$context_root" ]; then
		context_label="${context_root##*/}$context_suffix"
		context_specific="$context_linked_worktree"
	else
		context_path="${context_path%/}"
		context_label="${context_path##*/}"
	fi

	printf '%s\n%s\n' "$context_label" "$context_specific"
}

set_turn_start() {
	context_path="$(tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}

	context_specific="1"
	if [ -z "$project" ]; then
		project="$(get_pane_option @agent_pane_context_override)"
	fi
	if [ -z "$project" ]; then
		context_details="$(derive_project_details "$context_path")"
		project="$(printf '%s\n' "$context_details" | sed -n '1p')"
		context_specific="$(printf '%s\n' "$context_details" | sed -n '2p')"
	fi

	# A submitted prompt both begins this pane's active turn and resolves this
	# pane's previous input marker.
	tmux set-option -pq -t "$target" @agent_pane_attention '' \; \
		set-option -pq -t "$target" @agent_pane_attention_source '' \; \
		set-option -pq -t "$target" @agent_pane_attention_reason '' \; \
		set-option -pq -t "$target" @agent_pane_attention_updated_at '' \; \
		set-option -pq -t "$target" @agent_pane_context_active '1' \; \
		set-option -pq -t "$target" @agent_pane_context_project "$project" \; \
		set-option -pq -t "$target" @agent_pane_context_specific "$context_specific" \; \
		set-option -pq -t "$target" @agent_pane_context_updated_at "$(date +%s)"
	recompute_window_summary
}

set_project_override() {
	context_path="$(tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}

	case "$project_action" in
		set)
			tmux set-option -pq -t "$target" @agent_pane_context_override "$project"
			if [ "$(get_pane_option @agent_pane_context_active)" = "1" ]; then
				tmux set-option -pq -t "$target" @agent_pane_context_project "$project" \; \
					set-option -pq -t "$target" @agent_pane_context_specific '1'
			fi
			;;
		clear)
			tmux set-option -pq -t "$target" @agent_pane_context_override ''
			if [ "$(get_pane_option @agent_pane_context_active)" = "1" ]; then
				context_details="$(derive_project_details "$context_path")"
				inferred_project="$(printf '%s\n' "$context_details" | sed -n '1p')"
				inferred_specific="$(printf '%s\n' "$context_details" | sed -n '2p')"
				tmux set-option -pq -t "$target" @agent_pane_context_project "$inferred_project" \; \
					set-option -pq -t "$target" @agent_pane_context_specific "$inferred_specific"
			fi
			;;
	esac

	recompute_window_summary
}

set_turn_active() {
	if [ "$(get_pane_option @agent_pane_context_active)" = "1" ]; then
		return 0
	fi

	set_turn_start
}

set_turn_stop() {
	tmux display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1 || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}

	tmux set-option -pq -t "$target" @agent_pane_context_active '' \; \
		set-option -pq -t "$target" @agent_pane_context_project '' \; \
		set-option -pq -t "$target" @agent_pane_context_specific '' \; \
		set-option -pq -t "$target" @agent_pane_activity '' \; \
		set-option -pq -t "$target" @agent_pane_context_updated_at ''
	recompute_window_summary
}

set_turn_done() {
	tmux display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1 || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}

	: "${source:=turn}"
	: "${reason:=response_ready}"
	updated_at="$(date +%s)"

	# Apply the completed-turn transition in one tmux command queue so the pane
	# cannot briefly render as idle without its response-ready marker.
	tmux set-option -pq -t "$target" @agent_pane_attention 'done' \; \
		set-option -pq -t "$target" @agent_pane_attention_source "$source" \; \
		set-option -pq -t "$target" @agent_pane_attention_reason "$reason" \; \
		set-option -pq -t "$target" @agent_pane_attention_updated_at "$updated_at" \; \
		set-option -pq -t "$target" @agent_pane_context_active '' \; \
		set-option -pq -t "$target" @agent_pane_context_project '' \; \
		set-option -pq -t "$target" @agent_pane_context_specific '' \; \
		set-option -pq -t "$target" @agent_pane_activity '' \; \
		set-option -pq -t "$target" @agent_pane_context_updated_at ''
	recompute_window_summary
}

schedule_clear_if_viewed() {
	# Only a marker on the pane actually being viewed should auto-clear. Another
	# pane may be visible in the same active window while retaining its marker.
	attached_active="$(tmux display-message -p -t "$target" '#{session_attached} #{window_active} #{pane_active}' 2>/dev/null || printf '0 0 0')"
	# shellcheck disable=SC2086  # intentional split of three space-delimited flags
	set -- $attached_active
	attached="${1:-0}"
	active_window="${2:-0}"
	active_pane="${3:-0}"

	if [ "$attached" != "0" ] && [ "$active_window" = "1" ] && [ "$active_pane" = "1" ]; then
		script_dir="$TMUX_ATTENTION_DIR"
		"$script_dir/clear-after-delay" "$target"
	fi
}

print_get() {
	if ! require_target; then
		return 1
	fi

	tab="$(printf '\t')"
	target_fields="$(tmux display-message -p -t "$target" "#{pane_id}${tab}#{window_id}" 2>/dev/null)" || {
		printf 'tmux-attention: invalid target: %s\n' "$target" >&2
		return 1
	}
	pane_id="${target_fields%%"$tab"*}"
	window_id="${target_fields#*"$tab"}"
	state_value="$(get_pane_option @agent_pane_attention)"
	source_value="$(get_pane_option @agent_pane_attention_source)"
	reason_value="$(get_pane_option @agent_pane_attention_reason)"
	updated_at_value="$(get_pane_option @agent_pane_attention_updated_at)"
	owner_value="$(get_pane_option @agent_pane_owner)"
	verified_value="$(get_pane_option @agent_pane_attention_verified)"
	project_override_value="$(get_pane_option @agent_pane_context_override)"

	case "$format" in
		text)
			if [ -n "$state_value" ]; then
				printf '%s\n' "$state_value"
			fi
			;;
		json)
			printf '{"scope":"pane","target":'
			json_value "$pane_id"
			printf ',"window_id":'
			json_value "$window_id"
			printf ',"state":'
			json_value "$state_value"
			printf ',"source":'
			json_value "$source_value"
			printf ',"reason":'
			json_value "$reason_value"
			printf ',"updated_at":'
			json_value "$updated_at_value"
			printf ',"owner":'
			json_value "$owner_value"
			printf ',"project_override":'
			json_value "$project_override_value"
			printf ',"verified":'
			if [ "$verified_value" = "1" ]; then
				printf 'true'
			else
				printf 'false'
			fi
			printf '}\n'
			;;
	esac
}

print_list() {
	tab="$(printf '\t')"
	if [ -n "$session" ]; then
		list_output="$(tmux list-panes -s -t "$session" -F "#{session_name}${tab}#{window_index}${tab}#{window_id}${tab}#{window_name}${tab}#{pane_index}${tab}#{pane_id}${tab}#{@agent_pane_attention}${tab}#{@agent_pane_attention_source}${tab}#{@agent_pane_attention_reason}${tab}#{@agent_pane_attention_updated_at}" 2>/dev/null)" || {
			printf 'tmux-attention: invalid session: %s\n' "$session" >&2
			return 1
		}
	else
		list_output="$(tmux list-panes -a -F "#{session_name}${tab}#{window_index}${tab}#{window_id}${tab}#{window_name}${tab}#{pane_index}${tab}#{pane_id}${tab}#{@agent_pane_attention}${tab}#{@agent_pane_attention_source}${tab}#{@agent_pane_attention_reason}${tab}#{@agent_pane_attention_updated_at}" 2>/dev/null)" || return 1
	fi

	case "$format" in
		text)
			printf '%s\n' "$list_output" | while IFS="$(printf '\t')" read -r session_name window_index _window_id _window_name pane_index _pane_id state_value _source_value _reason_value _updated_at_value; do
				if [ -n "$state_value" ]; then
					printf '%s:%s.%s %s\n' "$session_name" "$window_index" "$pane_index" "$state_value"
				fi
			done
			;;
		json)
			printf '['
			first="true"
			printf '%s\n' "$list_output" | while IFS="$(printf '\t')" read -r session_name window_index window_id window_name pane_index pane_id state_value source_value reason_value updated_at_value; do
				if [ -z "$state_value" ]; then
					continue
				fi
				if [ "$first" = "true" ]; then
					first="false"
				else
					printf ','
				fi
				printf '{"session":'
				json_value "$session_name"
				printf ',"window_index":'
				json_value "$window_index"
				printf ',"window_id":'
				json_value "$window_id"
				printf ',"window_name":'
				json_value "$window_name"
				printf ',"pane_index":'
				json_value "$pane_index"
				printf ',"pane_id":'
				json_value "$pane_id"
				printf ',"state":'
				json_value "$state_value"
				printf ',"source":'
				json_value "$source_value"
				printf ',"reason":'
				json_value "$reason_value"
				printf ',"updated_at":'
				json_value "$updated_at_value"
				printf '}'
			done
			printf ']\n'
			;;
	esac
}

state="input"
state_set="false"
target=""
doctor_probe=""
format="text"
session=""
source=""
reason=""
event_type=""
activity_value=""
project=""
project_action=""
owner="${TMUX_ATTENTION_OWNER:-}"
write_verified=""
pane_owner=""
shell_name=""
wrap_commands=""

while [ "$#" -gt 0 ]; do
	case "$1" in
		--target|-t)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --target requires a tmux target\n' >&2
				usage >&2
				exit 2
			fi
			target="$2"
			shift 2
			;;
		--target=*)
			target="${1#--target=}"
			if [ -z "$target" ]; then
				printf 'tmux-attention: --target requires a tmux target\n' >&2
				usage >&2
				exit 2
			fi
			shift
			;;
		--owner)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --owner requires a value\n' >&2
				usage >&2
				exit 2
			fi
			owner="$2"
			shift 2
			;;
		--owner=*)
			owner="${1#--owner=}"
			shift
			;;
		--format)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --format requires text or json\n' >&2
				usage >&2
				exit 2
			fi
			format="$2"
			shift 2
			;;
		--format=*)
			format="${1#--format=}"
			shift
			;;
		--session)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --session requires a tmux session\n' >&2
				usage >&2
				exit 2
			fi
			session="$2"
			shift 2
			;;
		--session=*)
			session="${1#--session=}"
			shift
			;;
		--source)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --source requires a value\n' >&2
				usage >&2
				exit 2
			fi
			source="$2"
			shift 2
			;;
		--source=*)
			source="${1#--source=}"
			shift
			;;
		--reason)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --reason requires a value\n' >&2
				usage >&2
				exit 2
			fi
			reason="$2"
			shift 2
			;;
		--reason=*)
			reason="${1#--reason=}"
			shift
			;;
		--project)
			if [ "$#" -lt 2 ]; then
				printf 'tmux-attention: --project requires a value\n' >&2
				usage >&2
				exit 2
			fi
			project="$2"
			shift 2
			;;
		--project=*)
			project="${1#--project=}"
			shift
			;;
		--probe)
			case "$state" in
				doctor|check)
					doctor_probe="--probe"
					shift
					;;
				*)
					printf 'tmux-attention: unexpected argument: %s\n' "$1" >&2
					usage >&2
					exit 2
					;;
			esac
			;;
		*)
			if [ "$state_set" = "true" ]; then
				if [ "$state" = "event" ] && [ -z "$event_type" ]; then
					event_type="$1"
					shift
					continue
				elif [ "$state" = "project" ]; then
					if [ -z "$project_action" ]; then
						project_action="$1"
					elif [ "$project_action" = "set" ] && [ -z "$project" ]; then
						project="$1"
					else
						printf 'tmux-attention: unexpected argument: %s\n' "$1" >&2
						usage >&2
						exit 2
					fi
					shift
					continue
				elif [ "$state" = "shell-init" ]; then
					# First positional is the shell; any that follow name
					# commands to emit a full wrapper for.
					if [ -z "$shell_name" ]; then
						shell_name="$1"
					else
						wrap_commands="$wrap_commands $1"
					fi
					shift
					continue
				elif [ "$state" = "activity" ] && [ -z "$activity_value" ]; then
					activity_value="$1"
					shift
					continue
				else
					printf 'tmux-attention: unexpected argument: %s\n' "$1" >&2
					usage >&2
					exit 2
				fi
			fi
			state="$1"
			state_set="true"
			shift
			;;
	esac
done

_tab_char="$(printf '\t')"
_nl_char="$(printf '\nX')"; _nl_char="${_nl_char%X}"

case "$source" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --source must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$reason" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --reason must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$project" in
	*"$_tab_char"*|*"$_nl_char"*)
		printf 'tmux-attention: --project must not contain tabs or newlines\n' >&2
		usage >&2
		exit 2
		;;
esac

case "$format" in
	text|json)
		;;
	*)
		printf 'tmux-attention: unknown format: %s\n' "$format" >&2
		usage >&2
		exit 2
		;;
esac

case "$state" in
	input|blocked|review|done|clear|none|off)
		;;
	event)
		if [ -z "$event_type" ]; then
			printf 'tmux-attention: event requires an event name\n' >&2
			usage >&2
			exit 2
		fi
		;;
	activity)
		case "$activity_value" in
			*"$_tab_char"*|*"$_nl_char"*)
				printf 'tmux-attention: activity must not contain tabs or newlines\n' >&2
				usage >&2
				exit 2
				;;
		esac
		;;
	project)
		case "$project_action" in
			set)
				if [ -z "$project" ]; then
					printf 'tmux-attention: project set requires a project label\n' >&2
					usage >&2
					exit 2
				fi
				;;
			clear)
				if [ -n "$project" ]; then
					printf 'tmux-attention: project clear does not accept a project label\n' >&2
					usage >&2
					exit 2
				fi
				;;
			*)
				printf 'tmux-attention: project requires set <project> or clear\n' >&2
				usage >&2
				exit 2
				;;
		esac
		;;
	get|list|turn-start|turn-active|turn-stop|turn-done|refresh|claim|disown)
		;;
	shell-init)
		# Emits text only: no tmux server and no target required, so it runs
		# before the checks below and works outside tmux entirely.
		shell_init
		exit "$?"
		;;
	status-format|format)
		cat <<'EOF'
set -g window-status-format "#{E:@tmux_attention_status}#I:#W"
set -g window-status-current-format "#{E:@tmux_attention_status}#I:#W"
EOF
		exit 0
		;;
	catppuccin-format|catppuccin)
		cat <<'EOF'
set -g @catppuccin_window_text "#{E:@tmux_attention_status}#W"
set -g @catppuccin_window_current_text "#{E:@tmux_attention_status}#W"
EOF
		exit 0
		;;
	context-format|context)
		printf '%s\n' '#{E:@tmux_attention_context}'
		exit 0
		;;
	doctor|check)
		doctor "$doctor_probe"
		exit "$?"
		;;
	version|--version|-v)
		printf 'tmux-attention %s\n' "$TMUX_ATTENTION_VERSION"
		exit 0
		;;
	-h|--help|help)
		usage
		exit 0
		;;
	*)
		printf 'tmux-attention: unknown state: %s\n' "$state" >&2
		usage >&2
		exit 2
		;;
esac

case "$state" in
	get)
		if ! command -v tmux >/dev/null 2>&1; then
			printf 'tmux-attention: tmux command is not available\n' >&2
			exit 1
		fi
		print_get
		exit $?
		;;
	list)
		if ! command -v tmux >/dev/null 2>&1; then
			printf 'tmux-attention: tmux command is not available\n' >&2
			exit 1
		fi
		print_list
		exit $?
		;;
esac

if [ "$state" = "event" ]; then
	case "$event_type" in
		approval_required)
			state="input"
			: "${reason:=approval_required}"
			;;
		task_complete)
			state="done"
			: "${reason:=task_complete}"
			;;
		session_started)
			state="clear"
			: "${reason:=session_started}"
			;;
		tool_running|tool_finished)
			exit 0
			;;
		blocked|stop_failure|hook_failure)
			state="blocked"
			: "${reason:=$event_type}"
			;;
		review_required|needs_review)
			state="review"
			: "${reason:=$event_type}"
			;;
		*)
			printf 'tmux-attention: unknown event: %s\n' "$event_type" >&2
			usage >&2
			exit 2
			;;
	esac
	: "${source:=event}"
fi

if ! command -v tmux >/dev/null 2>&1; then
	printf '\a'
	exit 0
fi

resolve_target

if [ -z "$target" ]; then
	printf '\a'
	exit 0
fi

case "$state" in
	claim)
		claim_pane
		exit $?
		;;
	disown)
		disown_pane
		exit $?
		;;
esac

# Every write below goes through this one check, rather than each writer
# repeating it.
owner_matches || exit 1

case "$state" in
	project)
		set_project_override
		exit $?
		;;
	activity)
		require_target
		if [ "$activity_value" = "--clear" ]; then
			activity_value=""
		fi
		tmux set-option -pq -t "$target" @agent_pane_activity "$activity_value"
		recompute_window_summary
		;;
	refresh)
		recompute_window_summary
		exit $?
		;;
	turn-start)
		set_turn_start
		exit $?
		;;
	turn-active)
		set_turn_active
		exit $?
		;;
	turn-stop)
		set_turn_stop
		exit $?
		;;
	turn-done)
		set_turn_done || exit $?
		schedule_clear_if_viewed
		exit $?
		;;
esac

set_attention "$state"

case "$state" in
	clear|none|off)
		exit 0
		;;
esac

schedule_clear_if_viewed
